# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Namwinyu1995
DB_DATABASE=ucg_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_EXPIRATION=60m
JWT_REFRESH_EXPIRATION=30d

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

NOTIFICATION_SERVICE_URL=http://192.168.1.19:8060/send
CBS_TRANSFER_ENABLED=false

# APEF Integration
APEF_API_URL=https://uatapi.apef.co.tz
APEF_CLIENT_ID=your-apef-client-id
APEF_CLIENT_SECRET=your-apef-client-secret

# Logging (per-channel daily-rotating files)
LOG_DIR=./logs            # base directory for log files (per-channel subfolders)
LOG_MAX_FILES=30d         # retention (e.g. 30d, 90d, or a number of files)
LOG_MAX_SIZE=20m          # rotate a day's file if it exceeds this size
LOG_LEVEL=info            # info in prod, debug in development
LOG_CONSOLE=false         # also echo to console; auto-on when NODE_ENV=development